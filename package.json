{
  "name": "cwyd-v2",
  "private": true,
  "version": "0.0.1",
  "workspaces": [
    "src/frontend",
    "tests/frontend"
  ],
  "scripts": {
    "build": "npm run build --workspace cwyd-frontend",
    "dev": "npm run dev --workspace cwyd-frontend",
    "test": "npm run test --workspace cwyd-frontend-tests",
    "test:watch": "npm run test:watch --workspace cwyd-frontend-tests",
    "lint": "npm run lint --workspaces --if-present"
  },
  "overrides": {
    "@eslint/eslintrc@3.3.5": {
      "js-yaml": "4.3.0"
    },
    "esbuild": "0.28.1",
    "minimatch@3.1.5": {
      "brace-expansion": "1.1.18"
    },
    "minimatch@10.2.5": {
      "brace-expansion": "5.0.9"
    },
    "nanoid": "3.3.18",
    "postcss": "8.5.25"
  }
}
